# ── NextAuth / Auth.js (Google OAuth) ──────────────────────────────────
# Generate a secret: npx auth secret (or node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
AUTH_SECRET=your_auth_secret_here

# Google OAuth 2.0 Client credentials from Google Cloud Console (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google (and your production domain)
AUTH_GOOGLE_ID=your_google_client_id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your_google_client_secret

# ── Site & App URLs ──────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=https://app.hirelytics.ai

# ── Optional: Serverless Email Delivery (Resend / SMTP) ───────────────
# If set, form submissions on /book-demo, /contact, and newsletter will email notifications directly
# RESEND_API_KEY=re_123456789
# CONTACT_NOTIFICATION_EMAIL=hirelytics.ai@gmail.com
